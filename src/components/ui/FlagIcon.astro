---
/**
 * Runde Länderflagge als Inline-SVG (keine externen Dateien).
 * de = Deutschland · en = Vereinigtes Königreich · tr = Türkei
 * Die Flagge wird mittig quadratisch zugeschnitten und kreisrund maskiert.
 */
import type { Lang } from '@/config/routes';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className = 'size-7' } = Astro.props;
---

<span
  class:list={['flag inline-block shrink-0 overflow-hidden rounded-full', className]}
  aria-hidden="true"
>
  {lang === 'de' && (
    <svg viewBox="0 0 30 30" class="size-full">
      <rect width="30" height="10" y="0" fill="#000" />
      <rect width="30" height="10" y="10" fill="#DD0000" />
      <rect width="30" height="10" y="20" fill="#FFCE00" />
    </svg>
  )}
  {lang === 'en' && (
    <svg viewBox="15 0 30 30" class="size-full">
      <clipPath id="flag-uk-t">
        <path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" />
      </clipPath>
      <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
      <path
        d="M0,0 L60,30 M60,0 L0,30"
        clip-path="url(#flag-uk-t)"
        stroke="#C8102E"
        stroke-width="4"
      />
      <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
      <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
    </svg>
  )}
  {lang === 'tr' && (
    <svg viewBox="125 0 800 800" class="size-full">
      <rect x="0" y="0" width="1200" height="800" fill="#E30A17" />
      <circle cx="425" cy="400" r="200" fill="#fff" />
      <circle cx="475" cy="400" r="160" fill="#E30A17" />
      <polygon
        fill="#fff"
        points="583.334,400 764.235,458.779 652.431,304.894 652.431,495.106 764.235,341.221"
      />
    </svg>
  )}
</span>

<style>
  /* leichte 3D-Wirkung: Glanz oben, Schatten unten, feiner Rand */
  .flag {
    position: relative;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.25),
      0 2px 6px rgb(0 0 0 / 0.5);
  }
  .flag::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.35) 0%,
      rgb(255 255 255 / 0) 45%,
      rgb(0 0 0 / 0.18) 100%
    );
    pointer-events: none;
  }
</style>
