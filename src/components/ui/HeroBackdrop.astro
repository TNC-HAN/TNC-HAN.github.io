---
/**
 * Zusätzliches Licht hinter den Kopfbereichen (Startseite und Unterseiten):
 * leuchtende Nebelflächen in Blau, Lila, Rot und Gold über dem kosmischen
 * Seitenhintergrund (Cosmos.astro). Bewegt sich per Parallax langsamer als der Inhalt.
 * Rein dekorativ (aria-hidden), komplett CSS.
 */
interface Props {
  variant?: 'full' | 'soft';
}
const { variant = 'full' } = Astro.props;
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
  <div class="parallax absolute inset-0">
    <div class="absolute -top-40 right-[-10%] size-[46rem] animate-aurora rounded-full bg-nebula-blue/30 blur-[120px]"></div>
    <div class="absolute top-1/4 -left-40 size-[34rem] animate-aurora rounded-full bg-nebula-violet/30 blur-[110px] [animation-delay:-7s]"></div>
    {variant === 'full' && (
      <>
        <div class="absolute right-[18%] bottom-[-18%] size-[26rem] animate-aurora rounded-full bg-nebula-red/22 blur-[110px] [animation-delay:-13s]" />
        <div class="absolute top-[30%] left-[45%] size-[14rem] animate-aurora rounded-full bg-white/8 blur-[90px] [animation-delay:-4s]" />
      </>
    )}
  </div>
  <!-- weicher Übergang in den Seitenhintergrund -->
  <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-[#04030c]/50"></div>
</div>
