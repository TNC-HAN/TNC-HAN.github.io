---
/**
 * WhatsApp-Symbol in 3D: grüne, gewölbte Plakette mit Glanzkuppe, Innenschatten
 * und weißem Original-Zeichen (Pfad aus dem Paket „simple-icons“, CC0).
 * Nutzung des WhatsApp-Zeichens nur als Hinweis „Kontakt per WhatsApp“
 * (gemäß Markenrichtlinien von WhatsApp/Meta).
 */
import { siWhatsapp } from 'simple-icons';

interface Props {
  class?: string;
}
const { class: className = 'size-12' } = Astro.props;
---

<span class:list={['wa3d', className]} aria-hidden="true">
  <svg viewBox="0 0 24 24" class="wa3d-glyph">
    <path d={siWhatsapp.path} fill="currentColor"></path>
  </svg>
</span>

<style>
  .wa3d {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: #fff;
    /* gewölbte Oberfläche: hell oben links, sattes Grün, dunkler Rand unten rechts */
    background: radial-gradient(
      circle at 32% 26%,
      #9cf5bd 0%,
      #45e07f 26%,
      #25d366 48%,
      #128c4a 86%,
      #0b5f33 100%
    );
    box-shadow:
      inset 0 2px 2px rgb(255 255 255 / 0.55),
      inset 0 -4px 6px rgb(0 60 30 / 0.55),
      0 1px 0 rgb(255 255 255 / 0.15),
      0 6px 12px -2px rgb(0 0 0 / 0.6),
      0 0 18px rgb(37 211 102 / 0.45);
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.4s ease;
  }
  /* Glanzkuppe oben */
  .wa3d::before {
    content: '';
    position: absolute;
    top: 6%;
    left: 16%;
    width: 68%;
    height: 42%;
    border-radius: 9999px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0));
    pointer-events: none;
  }
  .wa3d-glyph {
    position: relative;
    width: 56%;
    height: 56%;
    filter: drop-shadow(0 1.5px 1px rgb(0 70 35 / 0.7));
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) .wa3d,
    :global(a:focus-visible) .wa3d {
      transform: translateY(-2px) scale(1.06) rotate(-6deg);
      box-shadow:
        inset 0 2px 2px rgb(255 255 255 / 0.55),
        inset 0 -4px 6px rgb(0 60 30 / 0.55),
        0 10px 18px -4px rgb(0 0 0 / 0.65),
        0 0 26px rgb(37 211 102 / 0.6);
    }
  }
</style>
