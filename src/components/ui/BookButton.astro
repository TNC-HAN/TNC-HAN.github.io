---
/** Haupt-CTA „Erstgespräch buchen“ – öffnet Calendly (Link in site.ts), sonst die Kontaktseite. */
import Icon from '@/components/ui/Icon.astro';
import { href, type Lang } from '@/config/routes';
import { site } from '@/config/site';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
  variant?: 'gold' | 'ghost';
  note?: boolean;
  class?: string;
  /** Eigene Beschriftung (Standard: „Erstgespräch buchen“) */
  label?: string;
  /** Kompakte Größe, z. B. unter FAQ-Antworten */
  small?: boolean;
}
const {
  lang,
  variant = 'gold',
  note = false,
  class: className,
  label,
  small = false,
} = Astro.props;
const dict = t(lang);
const url = site.contact.bookingUrl || href('contact', lang);
const external = Boolean(site.contact.bookingUrl);
---

<span class:list={['inline-flex flex-col items-start gap-2', className]}>
  <a
    href={url}
    class:list={[variant === 'gold' ? 'btn-gold' : 'btn-ghost', small && '!min-h-10 !px-5 text-sm']}
    {...(external ? { target: '_blank', rel: 'noopener' } : {})}
  >
    <Icon name="calendar" class="size-4" />
    {label ?? dict.cta.book}
  </a>
  {note && <span class="text-xs text-subtle">{dict.cta.bookNote}</span>}
</span>
