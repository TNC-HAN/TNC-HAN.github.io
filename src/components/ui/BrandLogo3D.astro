---
/**
 * Hauptlogo mit 3D-Wirkung und Glanz:
 * - Tiefe: gestaffelte Schatten (Prägung nach unten, Lichtkante oben, weicher Schlagschatten)
 * - Glanz: Spiegelung von oben (heller Verlauf) und ein Lichtstreif, der regelmäßig darüberläuft
 * - Hover: leichtes Kippen im Raum
 * Glanz und Lichtstreif sind exakt auf die Logoform maskiert (mask-image).
 * Bei „reduzierte Bewegung“ entfallen Lichtstreif und Kippen.
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt?: string;
  class?: string;
}
const { src, alt = '', class: className = 'h-8 w-auto lg:h-9' } = Astro.props;
// Kleine Fassung des Logos als Maske für Glanz-Ebenen
const mask = await getImage({ src, width: 320, format: 'png' });
---

<span class="logo3d" style={`--logo-mask: url(${mask.src})`}>
  <Image
    src={src}
    alt={alt}
    class:list={['logo3d-img', className]}
    loading="eager"
    widths={[160, 320]}
    sizes="160px"
  />
  <span class="logo3d-gloss" aria-hidden="true"></span>
  <span class="logo3d-shine" aria-hidden="true"></span>
</span>

<style>
  .logo3d {
    position: relative;
    display: inline-block;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Tiefe: Lichtkante oben, zwei Prägestufen in dunklem Gold, weicher Schatten, leichter Goldschein */
  .logo3d-img {
    display: block;
    filter: drop-shadow(0 -0.5px 0 rgb(255 248 225 / 0.55))
      drop-shadow(0 1px 0 rgb(122 92 40 / 0.95)) drop-shadow(0 1px 0 rgb(80 58 22 / 0.9))
      drop-shadow(0 3px 3px rgb(0 0 0 / 0.65)) drop-shadow(0 0 10px rgb(230 211 168 / 0.25));
  }

  /* Glanz-Ebenen exakt auf die Logoform zuschneiden */
  .logo3d-gloss,
  .logo3d-shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    -webkit-mask-image: var(--logo-mask);
    mask-image: var(--logo-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /* Spiegelung: oben hell, Mitte klar, unten leicht abgedunkelt – wirkt wie poliertes Metall */
  .logo3d-gloss {
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.55) 0%,
      rgb(255 255 255 / 0.18) 38%,
      rgb(255 255 255 / 0) 52%,
      rgb(0 0 0 / 0.18) 100%
    );
    mix-blend-mode: soft-light;
  }

  /* Lichtstreif, der über das Logo gleitet */
  .logo3d-shine {
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgb(255 255 255 / 0.85) 45%,
      rgb(255 250 230 / 0.95) 50%,
      rgb(255 255 255 / 0.85) 55%,
      transparent 70%
    );
    background-size: 250% 100%;
    background-position: 150% 0;
    mix-blend-mode: overlay;
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo3d-shine {
      animation: logo-shine 6s ease-in-out infinite 1.2s;
    }
    a:hover > .logo3d,
    a:focus-visible > .logo3d {
      transform: perspective(500px) rotateX(10deg) rotateY(-12deg) translateZ(6px);
    }
    a:hover > .logo3d .logo3d-shine {
      animation-duration: 1.6s;
    }
  }

  @keyframes logo-shine {
    0%,
    55% {
      background-position: 150% 0;
    }
    85%,
    100% {
      background-position: -60% 0;
    }
  }
</style>
