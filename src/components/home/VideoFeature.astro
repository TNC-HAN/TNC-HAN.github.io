---
/**
 * Imagefilm mit Musik (public/media/nexxcon-imagefilm.mp4, erzeugt mit scripts/make-video.ps1).
 * Startet stumm und in Schleife erst, wenn er sichtbar wird; bei „reduzierte Bewegung“
 * oder Datensparmodus nur mit Startknopf. Lädt vorher nur das Vorschaubild.
 */
import Icon from '@/components/ui/Icon.astro';
import BookButton from '@/components/ui/BookButton.astro';
import { asset, type Lang } from '@/config/routes';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const v = t(lang).video;
const soundLabel = { de: 'Mit Ton ansehen', en: 'Watch with sound', tr: 'Sesli izle' } as const;
---

<section class="container-site py-24 sm:py-28" aria-labelledby="video-title">
  <div class="reveal grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="gold-frame relative overflow-hidden rounded-[1.75rem] lg:col-span-7">
      <video
        data-autovideo
        class="aspect-video w-full bg-black object-cover"
        poster={asset('media/nexxcon-imagefilm-poster.jpg')}
        preload="none"
        muted
        loop
        playsinline
        controls
        aria-label={v.label}
      >
        <source src={asset('media/nexxcon-imagefilm.mp4')} type="video/mp4" />
      </video>
      <!-- Startet stumm (Browser-Regel); ein Klick spielt den Film mit Musik von vorn -->
      <button
        type="button"
        data-video-sound
        class="absolute top-4 left-4 inline-flex items-center gap-2 rounded-full border border-champagne/50 bg-black/60 px-4 py-2 text-sm font-semibold text-champagne backdrop-blur transition hover:bg-black/80"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M11 5 6 9H3v6h3l5 4V5Z" />
          <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" />
        </svg>
        {soundLabel[lang]}
      </button>
    </div>
    <div class="lg:col-span-5">
      <p class="eyebrow">{v.eyebrow}</p>
      <h2 id="video-title" class="mt-4 text-3xl leading-tight font-medium sm:text-5xl">
        {v.title}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">{v.text}</p>
      <ul class="mt-6 space-y-2.5">
        {v.points.map((p) => (
          <li class="flex items-center gap-3 text-text/90">
            <Icon name="check" class="size-5 shrink-0 text-gold" />
            {p}
          </li>
        ))}
      </ul>
      <BookButton lang={lang} class="mt-8" note />
    </div>
  </div>
</section>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    ?.saveData;
  document.querySelectorAll<HTMLVideoElement>('video[data-autovideo]').forEach((video) => {
    if (reduced || saveData || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting) video.play().catch(() => undefined);
        else video.pause();
      },
      { threshold: 0.4 },
    ).observe(video);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-video-sound]').forEach((btn) => {
    const video = btn.parentElement?.querySelector('video');
    if (!video) return;
    btn.addEventListener('click', () => {
      video.muted = false;
      video.currentTime = 0;
      video.play().catch(() => undefined);
      btn.hidden = true;
    });
    video.addEventListener('volumechange', () => {
      btn.hidden = !video.muted;
    });
  });
</script>
