---
/** Laufendes Themenband mit Pause-Knopf (WCAG 2.2.2). Pausiert auch bei Hover. */
import Icon from '@/components/ui/Icon.astro';
import { t } from '@/i18n';
import type { Lang } from '@/config/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
const items = dict.home.marquee;
---

<section
  class="relative border-y border-line bg-ink-900/60"
  data-marquee
  aria-label={dict.nav.services}
>
  <div class="flex items-center">
    <div class="group relative flex-1 overflow-hidden py-5 [mask-image:linear-gradient(90deg,transparent,black_8%,black_92%,transparent)]">
      <ul class="sr-only">
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <div
        aria-hidden="true"
        class="flex w-max animate-marquee group-hover:[animation-play-state:paused] [[data-paused]_&]:[animation-play-state:paused]"
      >
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {items.map((item) => (
              <span class="flex items-center gap-8 pr-8 font-display text-xl text-muted italic sm:text-2xl">
                {item}
                <span class="size-1.5 rotate-45 bg-gold" />
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <button
      type="button"
      data-marquee-toggle
      class="mx-3 flex size-10 shrink-0 items-center justify-center rounded-full border border-white/15 text-muted transition hover:text-text sm:mx-5"
      aria-label={dict.common.pause}
      data-label-pause={dict.common.pause}
      data-label-play={dict.common.play}
    >
      <Icon name="pause" class="size-4 [[data-paused]_&]:hidden" />
      <Icon name="play" class="hidden size-4 [[data-paused]_&]:block" />
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
    button?.addEventListener('click', () => {
      const paused = !root.hasAttribute('data-paused');
      root.toggleAttribute('data-paused', paused);
      button.setAttribute(
        'aria-label',
        (paused ? button.dataset.labelPlay : button.dataset.labelPause) ?? '',
      );
    });
  });
</script>
