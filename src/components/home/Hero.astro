---
/**
 * Startseiten-Einleitung unter dem Slide-Banner: Leitsatz (H1), Nutzenversprechen,
 * Haupt-CTAs und Vertrauenspunkte. Darüber liegt der kosmische Hintergrund.
 */
import Icon from '@/components/ui/Icon.astro';
import HeroBackdrop from '@/components/ui/HeroBackdrop.astro';
import BookButton from '@/components/ui/BookButton.astro';
import { href, serviceKeys, type Lang } from '@/config/routes';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
const { hero } = dict.home;
const icons = {
  consulting: 'compass',
  realEstate: 'building',
  ai: 'spark',
  emigration: 'plane',
} as const;
---

<section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
  <HeroBackdrop />
  <div class="container-site grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-12 lg:gap-10">
    <div class="min-w-0 lg:col-span-7">
      <!-- lang="en": englische Begriffe, damit die türkische Großschreibung kein „İ“ erzeugt -->
      <p class="eyebrow reveal" lang="en">
        {hero.eyebrow}
      </p>
      <h1
        id="hero-title"
        class="reveal mt-6 text-[2.1rem] leading-[1.04] font-medium break-words hyphens-auto min-[400px]:text-[2.6rem] sm:text-6xl lg:text-7xl"
      >
        {hero.title} <span class="text-gradient-gold block italic">{hero.titleAccent}</span>
      </h1>
      <p class="reveal mt-7 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{hero.lead}</p>
      <div class="reveal mt-10 flex flex-col gap-3 sm:flex-row sm:items-start">
        <BookButton lang={lang} note />
        <a href={href('contact', lang)} class="btn-ghost">
          {hero.primary}
          <Icon name="arrow" class="size-4" />
        </a>
      </div>
      <ul class="reveal mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted">
        {hero.trust.map((item) => (
          <li class="flex items-center gap-2">
            <Icon name="check" class="size-4 text-gold" />
            {item}
          </li>
        ))}
      </ul>
    </div>

    <!-- Schnellzugang zu den drei Bereichen -->
    <nav class="reveal min-w-0 lg:col-span-5" aria-label={dict.nav.services}>
      <ul class="space-y-3">
        {serviceKeys.map((key, i) => (
          <li>
            <a
              href={href(key, lang)}
              class="glass glass-hover group flex items-center gap-5 p-5 sm:p-6"
            >
              <span class="flex size-12 shrink-0 items-center justify-center rounded-full border border-gold/30 bg-gold/10 text-champagne">
                <Icon name={icons[key]} class="size-5" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs font-semibold tracking-[0.2em] text-subtle uppercase">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="mt-1 block font-display text-xl leading-snug whitespace-pre-line">
                  {dict.services[key].slide.title}
                </span>
                <span class="mt-1 block text-sm text-muted">{dict.services[key].label}</span>
              </span>
              <Icon
                name="arrow"
                class="size-5 shrink-0 text-subtle transition group-hover:translate-x-1 group-hover:text-champagne"
              />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>
