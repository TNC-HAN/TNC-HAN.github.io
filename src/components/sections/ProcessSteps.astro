---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { TitledText } from '@/i18n/types';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  steps: TitledText[];
}
const { eyebrow, title, lead, steps } = Astro.props;
---

<section class="relative py-24 sm:py-28" aria-labelledby="process-title">
  <div class="container-site">
    <SectionHeading id="process-title" eyebrow={eyebrow} title={title} lead={lead} />
    <div class="relative mt-16">
      <div
        aria-hidden="true"
        class="absolute top-6 right-0 left-0 hidden h-px bg-gradient-to-r from-gold/60 via-brand-400/40 to-transparent lg:block"
      ></div>
      <ol class="relative grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {steps.map((step, i) => (
          <li class="reveal relative">
            <span class="relative flex size-12 items-center justify-center rounded-full border border-gold/40 bg-ink-900 font-display text-lg text-champagne shadow-[0_0_30px_-5px_rgb(201_164_92/0.5)]">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-6 text-xl font-medium">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
