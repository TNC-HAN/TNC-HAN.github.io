---
/**
 * Ablauf in vier Phasen als anklickbare Boards (Startseite).
 * Jedes Board führt zur Seite „Arbeitsweise“ an die passende Phase.
 */
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import BookButton from '@/components/ui/BookButton.astro';
import { href, type Lang } from '@/config/routes';
import { t } from '@/i18n';
import type { TitledText } from '@/i18n/types';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  lead?: string;
  steps: TitledText[];
}
const { lang, eyebrow, title, lead, steps } = Astro.props;
const dict = t(lang);
---

<section class="relative py-24 sm:py-28" aria-labelledby="process-title">
  <div class="container-site">
    <SectionHeading id="process-title" eyebrow={eyebrow} title={title} lead={lead} />
    <ol class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {steps.map((step, i) => (
        <li class="reveal min-w-0">
          <a
            href={href('process', lang, `#phase-${i + 1}`)}
            class="glass glass-hover group flex h-full flex-col overflow-hidden p-6 sm:p-8"
          >
            <span class="pointer-events-none absolute -top-16 -right-16 size-40 rounded-full bg-brand-500/0 blur-3xl transition duration-700 group-hover:bg-brand-500/30" />
            <div class="flex items-start justify-between gap-3">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-full border border-gold/40 bg-gold/10 font-display text-lg text-champagne shadow-[0_0_30px_-5px_rgb(201_164_92/0.5)]">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-xs font-semibold tracking-[0.2em] text-subtle uppercase">
                {dict.processPage.phase} {i + 1}
              </span>
            </div>
            <h3 class="mt-8 text-2xl font-medium transition group-hover:text-champagne">
              {step.title}
            </h3>
            <p class="mt-3 leading-relaxed text-muted">{step.text}</p>
            <span class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-semibold text-champagne transition-all group-hover:gap-3">
              {dict.cta.details}
              <Icon name="arrow" class="size-4" />
            </span>
          </a>
        </li>
      ))}
    </ol>
    <div class="reveal mt-12">
      <BookButton lang={lang} note />
    </div>
  </div>
</section>
