---
/** Aufklappbare FAQ (ohne JavaScript). Strukturierte Daten erzeugt die Seite (faqJsonLd). */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import BookButton from '@/components/ui/BookButton.astro';
import CheckButton from '@/components/ui/CheckButton.astro';
import type { Lang } from '@/config/routes';
import { t } from '@/i18n';
import type { Faq } from '@/i18n/types';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  items: Faq[];
  /** Zusätzlich „KI-Potenzialanalyse starten“ unter jeder Antwort */
  check?: boolean;
}
const { lang, eyebrow, title, items, check = false } = Astro.props;
const dict = t(lang);
---

<section class="container-site py-24 sm:py-28" aria-labelledby="faq-title">
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-4">
      <SectionHeading id="faq-title" eyebrow={eyebrow} title={title} />
    </div>
    <div class="min-w-0 space-y-3 lg:col-span-8">
      {items.map((item, i) => (
        <details class="reveal glass group p-0" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-left text-lg font-medium break-words hyphens-auto sm:px-7 [&::-webkit-details-marker]:hidden">
            {item.q}
            <span
              aria-hidden="true"
              class="relative size-5 shrink-0 before:absolute before:top-1/2 before:left-0 before:h-px before:w-5 before:bg-champagne after:absolute after:top-0 after:left-1/2 after:h-5 after:w-px after:bg-champagne after:transition group-open:after:scale-y-0"
            />
          </summary>
          <div class="px-6 pb-6 sm:px-7">
            <p class="leading-relaxed text-muted">{item.a}</p>
            {/* CTA unter jeder Antwort – öffnet Calendly */}
            <div class="mt-5 flex flex-wrap items-center gap-3">
              {check && <CheckButton small />}
              <BookButton lang={lang} label={dict.bookNow} small />
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
