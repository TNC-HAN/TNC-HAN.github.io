---
/**
 * Raster aus Titel/Text-Kacheln (z. B. „Warum wir“, Leistungen, Märkte, Werte).
 * Mit `links` wird jede Kachel anklickbar (gleiche Reihenfolge wie `items`);
 * `ids` setzt Sprungmarken, damit andere Seiten direkt hierher verlinken können.
 */
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { TitledText } from '@/i18n/types';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  items: TitledText[];
  icons?: IconName[];
  columns?: 2 | 3 | 4;
  numbered?: boolean;
  links?: string[];
  ids?: string[];
  linkLabel?: string;
}
const {
  id,
  eyebrow,
  title,
  lead,
  items,
  icons,
  columns = 3,
  numbered = false,
  links,
  ids,
  linkLabel,
} = Astro.props;
const cols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
}[columns];
---

<section class="container-site py-24 sm:py-28" aria-labelledby={id}>
  <SectionHeading id={id} eyebrow={eyebrow} title={title} lead={lead} />
  <ul class:list={['mt-14 grid gap-5', cols]}>
    {items.map((item, i) => {
      const icon = icons?.[i % icons.length];
      const link = links?.[i];
      const body = (
        <Fragment>
          {icon && (
            <span class="flex size-11 items-center justify-center rounded-full border border-brand-400/30 bg-brand-500/10 text-brand-300 transition group-hover:border-champagne/50 group-hover:text-champagne">
              <Icon name={icon} class="size-5" />
            </span>
          )}
          {numbered && !icon && (
            <span class="font-display text-sm tracking-widest text-gold">
              {String(i + 1).padStart(2, '0')}
            </span>
          )}
          <h3 class="mt-5 text-xl font-medium">{item.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{item.text}</p>
          {link && linkLabel && (
            <span class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold text-champagne transition-all group-hover:gap-3">
              {linkLabel}
              <Icon name="arrow" class="size-4" />
            </span>
          )}
        </Fragment>
      );
      return (
        <li class="reveal scroll-mt-28" id={ids?.[i]}>
          {link ? (
            <a href={link} class="glass glass-hover group flex h-full flex-col p-7">
              {body}
            </a>
          ) : (
            <div class="glass glass-hover flex h-full flex-col p-7">{body}</div>
          )}
        </li>
      );
    })}
  </ul>
</section>
