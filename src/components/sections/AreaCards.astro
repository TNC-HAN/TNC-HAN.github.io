---
/** Die drei Geschäftsbereiche als Karten – Reihenfolge aus serviceKeys. */
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { href, serviceKeys, type Lang, type ServiceKey } from '@/config/routes';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
  /** Diesen Bereich ausblenden (z. B. auf seiner eigenen Unterseite) */
  exclude?: ServiceKey;
  heading?: boolean;
}
const { lang, exclude, heading = true } = Astro.props;
const dict = t(lang);
const icons = {
  consulting: 'compass',
  realEstate: 'building',
  ai: 'spark',
  emigration: 'plane',
} as const;
const keys = serviceKeys.filter((k) => k !== exclude);
---

<section
  id="bereiche"
  class="container-site scroll-mt-24 py-24 sm:py-28"
  aria-labelledby="areas-title"
>
  {heading && <SectionHeading id="areas-title" {...dict.home.areas} />}
  <ol
    class:list={[
      'grid gap-5',
      heading && 'mt-14',
      keys.length >= 4 ? 'md:grid-cols-2' : keys.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2',
    ]}
  >
    {keys.map((key) => {
      const s = dict.services[key];
      const number = String(serviceKeys.indexOf(key) + 1).padStart(2, '0');
      return (
        <li class="reveal">
          <a
            href={href(key, lang)}
            class="glass glass-hover group flex h-full flex-col overflow-hidden p-7 sm:p-8"
          >
            <span class="pointer-events-none absolute -top-16 -right-16 size-40 rounded-full bg-brand-500/0 blur-3xl transition duration-700 group-hover:bg-brand-500/30" />
            <div class="flex items-start justify-between">
              <span class="flex size-12 items-center justify-center rounded-full border border-gold/30 bg-gold/10 text-champagne">
                <Icon name={icons[key]} class="size-6" />
              </span>
              <span class="font-display text-4xl text-white/10 transition group-hover:text-gold/40">
                {number}
              </span>
            </div>
            <h3 class="mt-8 text-2xl leading-snug font-medium break-words whitespace-pre-line hyphens-auto">
              {s.card.title}
            </h3>
            <p class="mt-3 leading-relaxed text-muted">{s.card.text}</p>
            <ul class="mt-6 space-y-2.5 text-sm text-text/85">
              {s.card.points.map((p) => (
                <li class="flex items-center gap-2.5">
                  <span class="size-1 rotate-45 bg-gold" />
                  {p}
                </li>
              ))}
            </ul>
            <span class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-semibold text-champagne transition-all group-hover:gap-3">
              {dict.common.learnMore}
              <Icon name="arrow" class="size-4" />
            </span>
          </a>
        </li>
      );
    })}
  </ol>
</section>
