---
/**
 * Sprachumschalter mit runden Flaggen (DE · EN · TR) – verlinkt jeweils auf dieselbe
 * Seite in der anderen Sprache. Aktive Sprache: goldener Ring.
 */
import FlagIcon from '@/components/ui/FlagIcon.astro';
import { href, languages, type Lang, type PageKey } from '@/config/routes';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
  page: PageKey | null;
}
const { lang, page } = Astro.props;
---

<nav aria-label={t(lang).nav.language}>
  <ul class="flex items-center gap-0.5 rounded-full sm:gap-1 border border-white/12 bg-white/[0.03] p-1">
    {languages.map((l) => (
      <li>
        <a
          href={href(page ?? 'home', l)}
          hreflang={t(l).meta.htmlLang}
          lang={t(l).meta.htmlLang}
          aria-current={l === lang ? 'true' : undefined}
          title={t(l).meta.languageName}
          class="flex size-8 items-center justify-center rounded-full sm:size-9 opacity-60 transition duration-300 hover:scale-110 hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:ring-2 aria-[current=true]:ring-champagne/80"
        >
          <span class="sr-only">{t(l).meta.languageName}</span>
          <FlagIcon lang={l} class="size-6 sm:size-7" />
        </a>
      </li>
    ))}
  </ul>
</nav>
