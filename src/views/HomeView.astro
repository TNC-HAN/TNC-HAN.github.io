---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Marquee from '@/components/home/Marquee.astro';
import AreaCards from '@/components/sections/AreaCards.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import FeatureGrid from '@/components/sections/FeatureGrid.astro';
import FaqList from '@/components/sections/FaqList.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { faqJsonLd } from '@/lib/structured-data';
import type { Lang } from '@/config/routes';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { home } = t(lang);
---

<BaseLayout lang={lang} page="home" {...home.seo} jsonLd={[faqJsonLd(home.faq.items)]}>
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <AreaCards lang={lang} />
  <div class="hairline"></div>
  <ProcessSteps {...home.process} />
  <FeatureGrid
    id="why-title"
    {...home.why}
    columns={4}
    icons={['compass', 'key', 'globe', 'spark']}
  />
  <FeatureGrid id="regions-title" {...home.regions} columns={4} icons={['pin']} />
  <FaqList {...home.faq} />
  <CtaBand lang={lang} />
</BaseLayout>
