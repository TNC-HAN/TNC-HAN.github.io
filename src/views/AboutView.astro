---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import nexxcon from '@/assets/brand/nexxcon-logo.png';
import nexxus from '@/assets/brand/nexxus-logo.png';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import FeatureGrid from '@/components/sections/FeatureGrid.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import RichText from '@/components/ui/RichText.astro';
import SmartJustify from '@/components/ui/SmartJustify.astro';
import NetworkGlobe from '@/components/about/NetworkGlobe.astro';
import { href, type Lang } from '@/config/routes';
import { site } from '@/config/site';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
const { about } = dict;
/**
 * Porträtfoto: liegt als src/assets/team/portrait.png vor (erzeugt mit
 * scripts/make-portrait.py). Fehlt die Datei, erscheinen die Initialen.
 */
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/team/portrait.{png,jpg,jpeg,webp}',
  {
    eager: true,
  },
);
const portrait = Object.values(photos)[0]?.default;
const initials = site.owner
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<BaseLayout lang={lang} page="about" {...about.seo}>
  <PageHero lang={lang} {...about.hero} current={dict.nav.about} />

  <!--
    Ansprechpartner – mobil zuerst:
    Handy & Tablet: Foto oben mittig, Kopfzeilen zentriert, Text darunter (breite Textspalte)
    Laptop (lg): Foto links, Text rechts · große Bildschirme (xl): größeres Foto, mehr Luft
  -->
  <section class="container-site py-12 sm:py-16" aria-labelledby="profile-title">
    <div class="reveal glass grid items-center gap-8 p-6 sm:gap-10 sm:p-10 lg:grid-cols-[auto_1fr] lg:gap-14 lg:p-14 xl:gap-16">
      <div class="portrait-glow relative mx-auto size-56 shrink-0 rounded-full sm:size-64 lg:size-72 xl:size-80">
        {portrait ? (
          <Image
            src={portrait}
            alt={`${site.ownerTitle} ${site.owner}`}
            class="size-full rounded-full object-cover"
            widths={[240, 320, 480, 640]}
            sizes="(min-width: 1280px) 320px, (min-width: 1024px) 288px, (min-width: 640px) 256px, 224px"
            loading="lazy"
          />
        ) : (
          <div
            aria-hidden="true"
            class="flex size-full items-center justify-center rounded-full border border-gold/40 bg-gradient-to-br from-ink-700 to-ink-900 font-display text-6xl text-champagne"
          >
            {initials}
          </div>
        )}
      </div>

      <div class="min-w-0">
        <div class="text-center lg:text-left">
          <p class="eyebrow justify-center lg:justify-start">{about.profile.eyebrow}</p>
          <h2 id="profile-title" class="mt-4 text-3xl font-medium sm:text-4xl xl:text-5xl">
            {about.profile.title}
          </h2>
          <p class="mt-2 text-champagne">{about.profile.role}</p>
        </div>
        <SmartJustify class="mx-auto mt-6 max-w-2xl space-y-3 text-base leading-relaxed text-muted sm:text-lg lg:mx-0 lg:mt-7">
          {about.profile.bio.split('\n').map((line) => (
            <p>
              <RichText text={line} />
            </p>
          ))}
        </SmartJustify>
      </div>
    </div>
  </section>

  <!-- Netzwerk: D-A-CH und global (interaktiver Globus) -->
  <NetworkGlobe lang={lang} />

  <FeatureGrid
    id="values-title"
    {...about.values}
    icons={['shield', 'check', 'key']}
    links={[href('contact', lang), href('contact', lang), href('contact', lang)]}
    linkLabel={dict.cta.book}
  />

  <section class="container-site py-16" aria-labelledby="brands-title">
    <div class="reveal glass grid gap-10 p-8 sm:p-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">{about.brands.eyebrow}</p>
        <h2 id="brands-title" class="mt-4 text-3xl font-medium sm:text-4xl">
          {about.brands.title}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">{about.brands.text}</p>
        <p class="mt-4 text-sm text-subtle">{site.company}</p>
      </div>
      <div class="flex flex-col items-start gap-10 sm:flex-row sm:items-center lg:justify-end">
        <Image
          src={nexxcon}
          alt="nexxcon – business RE solutions"
          class="h-14 w-auto"
          widths={[280, 560]}
          sizes="280px"
        />
        <Image
          src={nexxus}
          alt="nexxus Consulting"
          class="h-16 w-auto"
          widths={[170, 340]}
          sizes="170px"
        />
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
