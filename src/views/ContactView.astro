---
/**
 * Kontakt ohne Formular: Telefon, E-Mail, WhatsApp, Terminbuchung (Link in site.ts).
 * Telefon und E-Mail öffnen am Smartphone direkt die passende App, am Laptop ein
 * Auswahlfenster mit den gängigsten Programmen (ContactLauncher).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import WhatsAppIcon3D from '@/components/ui/WhatsAppIcon3D.astro';
import type { Lang } from '@/config/routes';
import { site, whatsappUrl } from '@/config/site';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
const { contact, launcher } = dict;
const booking: string = site.contact.bookingUrl;

interface Channel {
  icon: IconName | 'whatsapp';
  label: string;
  value: string;
  text: string;
  href?: string;
  external?: boolean;
  /** Anbindung an das Auswahlfenster (Telefon/E-Mail) */
  launch?: 'phone' | 'email';
}

const channels: Channel[] = [
  {
    icon: 'phone',
    label: dict.common.phone,
    value: site.contact.phoneDisplay,
    text: contact.channels.phoneText,
    href: `tel:${site.contact.phoneIntl}`,
    launch: 'phone',
  },
  {
    icon: 'mail',
    label: dict.common.email,
    value: site.contact.email,
    text: contact.channels.emailText,
    href: `mailto:${site.contact.email}?subject=${encodeURIComponent(launcher.emailSubject)}`,
    launch: 'email',
  },
  {
    icon: 'whatsapp',
    label: dict.common.whatsapp,
    value: site.contact.phoneDisplay,
    text: contact.channels.whatsappText,
    href: whatsappUrl(dict.common.whatsappMessage),
    external: true,
  },
  booking
    ? {
        icon: 'calendar',
        label: dict.common.booking,
        value: 'Calendly',
        text: contact.channels.bookingText,
        href: booking,
        external: true,
      }
    : {
        icon: 'calendar',
        label: dict.common.booking,
        value: '—',
        text: dict.common.bookingPending,
      },
];
---

<BaseLayout lang={lang} page="contact" {...contact.seo}>
  <PageHero lang={lang} {...contact.hero} current={dict.nav.contact} />

  <section class="container-site pb-16" aria-labelledby="channels-title">
    <h2 id="channels-title" class="sr-only">
      {contact.channels.title}
    </h2>
    <ul class="grid gap-5 sm:grid-cols-2">
      {channels.map((c) => {
        const inner = (
          <Fragment>
            {c.icon === 'whatsapp' ? (
              <WhatsAppIcon3D class="size-12" />
            ) : (
              <span class="flex size-12 items-center justify-center rounded-full border border-gold/30 bg-gold/10 text-champagne">
                <Icon name={c.icon} class="size-5" />
              </span>
            )}
            <span class="mt-6 block text-xs font-semibold tracking-[0.2em] text-subtle uppercase">
              {c.label}
            </span>
            <span class="mt-2 block font-display text-2xl break-words sm:text-3xl">{c.value}</span>
            <span class="mt-2 block text-muted">{c.text}</span>
          </Fragment>
        );
        return (
          <li class="reveal relative">
            {c.href ? (
              <a
                href={c.href}
                class="glass glass-hover block h-full p-8"
                data-launch={c.launch}
                {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {inner}
              </a>
            ) : (
              <div class="glass block h-full p-8 opacity-80">{inner}</div>
            )}
            {c.launch && (
              <button
                type="button"
                hidden
                data-launch-change={c.launch}
                class="absolute top-7 right-7 rounded-full border border-white/12 px-3 py-1.5 text-xs text-muted transition hover:border-champagne/50 hover:text-text"
              >
                {launcher.change}
              </button>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <section class="container-site py-16">
    <div class="grid gap-5 lg:grid-cols-2">
      <div class="reveal glass p-8 sm:p-10">
        <h2 class="text-2xl font-medium">{contact.prepare.title}</h2>
        <ul class="mt-6 space-y-3">
          {contact.prepare.items.map((item) => (
            <li class="flex gap-3 text-muted">
              <Icon name="check" class="mt-0.5 size-5 shrink-0 text-gold" />
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal glass relative overflow-hidden p-8 sm:p-10">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -top-20 -right-20 size-64 rounded-full bg-brand-500/25 blur-3xl"
        ></div>
        <div class="relative">
          <span class="flex size-12 items-center justify-center rounded-full border border-brand-400/30 bg-brand-500/10 text-brand-300">
            <Icon name="pin" class="size-5" />
          </span>
          <h2 class="mt-6 text-2xl font-medium">{contact.location.title}</h2>
          <p class="mt-3 font-display text-xl">
            {site.address.zip}
            {site.address.city}
          </p>
          <p class="text-muted">
            {site.address.region} · {site.address.country}
          </p>
          <p class="mt-5 leading-relaxed text-muted">{contact.location.text}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
